
# 1. Groq AI Integration
# Get your API key here: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional provider fallback chain
# PROVIDER_1_NAME=groq
# PROVIDER_1_API_KEY=your_groq_api_key_here
# PROVIDER_1_BASE_URL=https://api.groq.com/openai/v1
# PROVIDER_1_MODEL=llama-3.3-70b-versatile

# 2. Supabase Configuration
# Get these from: Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 3. (Optional) Google Maps Static API
# Needed for the Crisis Map nearby centers view
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# 4. Security / Admin Seeds
# Initial admins seeded in your database migration:
# admin@soulsync.org, manager@soulsync.org
