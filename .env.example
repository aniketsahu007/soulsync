
# 1. OpenRouter (GPT) AI Integration
# Get your API Key here: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# 2. Supabase Configuration
# Get these from: Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 3. (Optional) Google Maps Static API
# Needed for the Crisis Map nearby centers view
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# 4. Security / Admin Seeds
# Initial admins seeded in your database migration:
# admin@soulsync.org, manager@soulsync.org
