{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ─── App Identity ───────────────────────────────────────────────────────────
  "name": "soulsyncc",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],

  // TanStack Start SSR entry point (Cloudflare Workers adapter)
  "main": "dist/server/server.js",

  // ─── Assets (Static Files) ─────────────────────────────────────────────────
  // Vite outputs the client build to dist/client
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },


  // ─── Cloudflare Cron Triggers ──────────────────────────────────────────────
  // Fires the /api/cron-reminders endpoint every 5 minutes automatically.
  // This replaces the need for an external cron service.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // ─── Observability ─────────────────────────────────────────────────────────
  "observability": {
    "enabled": true
  },

  // Non-secret runtime configuration. Keep API keys in Cloudflare/GitHub secrets.
  "vars": {
    "PROVIDER_1_NAME": "groq",
    "PROVIDER_1_BASE_URL": "https://api.groq.com/openai/v1",
    "PROVIDER_1_MODEL": "llama-3.3-70b-versatile",
    "PROVIDER_2_NAME": "cerebras",
    "PROVIDER_2_BASE_URL": "https://api.cerebras.ai/v1",
    "PROVIDER_2_MODEL": "gpt-oss-120b"
  }
}
